<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiTodo.Models"
             x:Class="MauiTodo.MainPage"
             Title="My Todos">

    <!-- Row 0: the input bar (Auto = as tall as it needs).
         Row 1: the list (* = all remaining space). -->
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Column 0 stretches (*), column 1 fits the button (Auto) -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="NewTodoEntry"
                   Placeholder="What do you need to do?"
                   ReturnType="Done"
                   Completed="OnAddClicked" />
            <Button Grid.Column="1" Text="Add" Clicked="OnAddClicked" />
        </Grid>

        <CollectionView x:Name="TodoList" Grid.Row="1">

            <!-- Shown when the list is empty -->
            <CollectionView.EmptyView>
                <Label Text="Nothing to do. Enjoy the beach!"
                       TextColor="Gray"
                       HorizontalOptions="Center" Margin="0,48" />
            </CollectionView.EmptyView>

            <!-- The cookie cutter: how ONE item looks -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid ColumnDefinitions="Auto,*" Padding="4,6">
                        <CheckBox IsChecked="{Binding IsDone}" />
                        <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>